{
  "name": "clipse-radar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm -r --if-present test",
    "build": "pnpm --filter @clipse/core build && pnpm --filter @clipse/web build && pnpm --filter @clipse/edge build && pnpm --filter @clipse/engine build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250408.0",
    "@eslint/js": "^9.24.0",
    "eslint": "^9.24.0",
    "eslint-plugin-import-x": "^4.10.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.0",
    "vitest": "^3.1.1",
    "wrangler": "^4.10.0"
  }
}
