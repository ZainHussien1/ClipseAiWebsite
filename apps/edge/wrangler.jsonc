{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clipse-radar-edge",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/hooks/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clipse-radar-db",
      "database_id": "0b4693d5-eec1-4ab6-a6c6-5a9911de24a8",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACE_DO",
        "class_name": "WorkspaceDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkspaceDO"]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGEST_QUEUE",
        "queue": "ingest-queue"
      },
      {
        "binding": "NOTIFY_QUEUE",
        "queue": "notify-queue"
      }
    ]
  },
  "services": [
    {
      "binding": "ENGINE",
      "service": "clipse-radar-engine",
      "entrypoint": "EngineEntrypoint"
    }
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "AI_INSIGHTS_ENABLED": "false"
  },
  "env": {
    "production": {
      "name": "clipse-radar",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "clipse-radar-prod-db",
          "database_id": "007589e9-208a-4aa3-a21a-8f17eafdad1f",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "WORKSPACE_DO",
            "class_name": "WorkspaceDO"
          }
        ]
      },
      "queues": {
        "producers": [
          {
            "binding": "INGEST_QUEUE",
            "queue": "ingest-queue-prod"
          },
          {
            "binding": "NOTIFY_QUEUE",
            "queue": "notify-queue-prod"
          }
        ]
      },
      "services": [
        {
          "binding": "ENGINE",
          "service": "clipse-radar-engine-prod",
          "entrypoint": "EngineEntrypoint"
        }
      ],
      "vars": {
        "ENVIRONMENT": "prod",
        "AI_INSIGHTS_ENABLED": "false"
      }
    }
  }
}
