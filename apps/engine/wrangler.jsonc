{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clipse-radar-engine",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clipse-radar-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "ingest-queue",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "dead_letter_queue": "ingest-dlq"
      },
      {
        "queue": "notify-queue",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "dead_letter_queue": "notify-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *", "0 * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "local",
    "AI_INSIGHTS_ENABLED": "false"
  }
}
